{
  "name": "localmcp",
  "version": "0.3.0",
  "description": "localmcp: a local, scoped, read-first browser for AI agents over MCP and the shell. The page itself, not a summary.",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "localmcp": "dist/bin/localmcp.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/bin/localmcp.js",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "build:site": "cd hero-proto && npx vite build",
    "bench": "tsx benchmarks/run.ts"
  },
  "keywords": [
    "mcp",
    "browser",
    "headless",
    "ai",
    "agent",
    "playwright",
    "claude",
    "cursor",
    "automation",
    "markdown",
    "local",
    "private",
    "security",
    "model-context-protocol",
    "mcp-server",
    "web-scraping",
    "sampling",
    "firefox",
    "webkit",
    "safari",
    "edge"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NETWORK101/browsermcp.ai"
  },
  "homepage": "https://github.com/NETWORK101/browsermcp.ai#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^9.0.0",
    "jsdom": "^24.1.3",
    "playwright": "^1.48.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8"
  },
  "mcpName": "io.github.network101/localmcp"
}
